PORT = 3000

DATABASE_URL = "postgresql://postgres:postgres@localhost:5432/votium?schema=public"

# JWT expiry value is expressed in seconds.
JWT_SECRET = my_jwt_secret # Change this to a strong secret in production
JWT_EXPIRES_IN = 3600 # 1 hour in seconds

# SMTP configuration for MFA verification emails (Gmail account).
SMTP_HOST = smtp.gmail.com
SMTP_PORT = 587
SMTP_SECURE = false
SMTP_USER = votiumvalleu@gmail.com
SMTP_PASS = <gmail-app-password> #jtdusmsserkrayxo
EMAIL_FROM = votiumvalleu@gmail.com

# JWT is transmitted through an HttpOnly cookie.
# AUTH_COOKIE_SECURE must remain true in production.
AUTH_COOKIE_NAME = access_token
AUTH_COOKIE_SECURE = true
AUTH_COOKIE_SAMESITE = lax # strict | lax | none (none requires secure=true)
# AUTH_COOKIE_DOMAIN = example.com # Optional; only set when the cookie needs a domain.

# Comma-separated allowed CORS origins (no wildcard when credentials are enabled).
CORS_ORIGINS = http://localhost:5173

