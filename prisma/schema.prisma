// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum StatusElection {
  PENDING
  CREATED
  ACTIVE
  CLOSED
  PUBLISHED
  CANCELLED
  FINALIZING
  SYNC_ERROR
}

model Role {
  id   String @id @default(uuid())
  name String @unique

  users User[]

  @@map("roles")
}

model User {
  id            String    @id @default(uuid())
  first_name    String
  last_name     String
  email         String    @unique
  password_hash String
  role_id       String
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  status        String    @default("ACTIVE")
  deleted_at    DateTime?

  role                  Role                    @relation(fields: [role_id], references: [id])
  auditLogs             AuditLog[]
  notifications         Notification[]
  reports               Report[]
  statusHistory         ElectionStatusHistory[]
  mfaChallenges         MfaChallenge[]
  passwordRecoveryCodes PasswordRecoveryCode[]

  @@map("users")
}

model MfaChallenge {
  id          String    @id @default(uuid())
  user_id     String
  session_id  String    @unique
  otp_hash    String
  attempts    Int       @default(0)
  expires_at  DateTime
  resend_at   DateTime?
  consumed_at DateTime?
  created_at  DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@map("mfa_challenges")
}

model AuditLog {
  id        String   @id @default(uuid())
  user_id   String
  action    String
  reason    String?
  details   String?
  timestamp DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@map("audit_logs")
}

model Election {
  id                 String         @id @default(uuid())
  electionCode       String         @unique @map("election_code") @db.VarChar(20)
  name               String
  description        String
  start_date         DateTime       @db.Date()
  start_time         DateTime       @db.Time()
  end_date           DateTime       @db.Date()
  end_time           DateTime       @db.Time()
  current_status     StatusElection @default(PENDING)
  blank_vote_enabled Boolean        @default(false)
  created_at         DateTime       @default(now())
  signing_public_key String?
  ledger_tx_id       String?
  ledger_block       Int?
  started_at         DateTime?
  closed_at          DateTime?
  published_at       DateTime?
  canceled_at        DateTime?
  updated_at         DateTime?      @updatedAt

  reports              Report[]
  notifications        Notification[]
  candidacies          Candiday[]
  results              Result[]
  electoralRolls       ElectoralRoll[]
  certificates         Certificate[]
  statusHistory        ElectionStatusHistory[]
  voteMetadata         VoteMetadata[]
  anonymousElectionKey AnonymousElectionKey?
  anonymousCredentials AnonymousCredential[]
  anonymousCommitments AnonymousCommitment[]
  anonymousVotes       AnonymousVote[]

  @@unique([name])
  @@map("elections")
}

model ElectionCodeCounter {
  period    String @id @db.Char(6)
  lastValue Int    @map("last_value")

  @@map("election_code_counters")
}

model ElectionStatusHistory {
  id          String         @id @default(uuid())
  election_id String
  user_id     String? // NULL = system/automatic transition (no human actor)
  old_status  StatusElection
  new_status  StatusElection
  changed_at  DateTime       @default(now())

  election Election @relation(fields: [election_id], references: [id])
  user     User?    @relation(fields: [user_id], references: [id])

  @@map("election_status_history")
}

model VoteMetadata {
  id          String @id @default(uuid())
  election_id String
  tx_hash     String

  election Election @relation(fields: [election_id], references: [id])

  @@map("vote_metadata")
}

model Notification {
  id          String   @id @default(uuid())
  user_id     String
  message     String
  sent_to     Json
  election_id String
  created_at  DateTime @default(now())

  user     User     @relation(fields: [user_id], references: [id])
  election Election @relation(fields: [election_id], references: [id])

  @@map("notifications")
}

model Report {
  id          String   @id @default(uuid())
  user_id     String
  description String
  file_url    String?
  election_id String
  created_at  DateTime @default(now())

  user     User     @relation(fields: [user_id], references: [id])
  election Election @relation(fields: [election_id], references: [id])

  @@map("reports")
}

model Candidate {
  id                       String    @id @default(uuid())
  first_name               String
  last_name                String
  student_code             String    @unique
  program_code             String
  identification_number    String    @unique
  status                   String
  companion_first_name     String?
  companion_last_name      String?
  companion_student_code   String?
  companion_program_code   String?
  companion_identification String?
  email                    String?
  phone                    String?
  created_at               DateTime  @default(now())
  deleted_at               DateTime?

  candidays Candiday[]

  @@map("candidates")
}

model Candiday {
  id              String   @id @default(uuid())
  candidate_id    String
  election_id     String
  position_number Int
  image_url       String?
  created_at      DateTime @default(now())

  candidate Candidate @relation(fields: [candidate_id], references: [id])
  election  Election  @relation(fields: [election_id], references: [id])
  results   Result[]

  @@unique([candidate_id, election_id])
  @@unique([position_number, election_id])
  @@map("candidacies")
}

model Result {
  id           String   @id @default(uuid())
  election_id  String
  candidacy_id String
  votes        Int
  updated_at   DateTime @default(now())

  election  Election @relation(fields: [election_id], references: [id])
  candidacy Candiday @relation(fields: [candidacy_id], references: [id])

  @@unique([election_id, candidacy_id])
  @@map("results")
}

model Elector {
  id             String    @id @default(uuid())
  first_name     String
  last_name      String
  email          String    @unique
  password_hash  String
  student_code   String    @unique
  program_code   String
  identification String?   @unique
  status         String
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?

  electoralRolls        ElectoralRoll[]
  mfaChallenges         ElectorMfaChallenge[]
  anonymousCredentials  AnonymousCredential[]
  passwordRecoveryCodes ElectorPasswordRecoveryCode[]

  @@map("electors")
}

model ElectorMfaChallenge {
  id          String    @id @default(uuid())
  elector_id  String
  session_id  String    @unique
  otp_hash    String
  attempts    Int       @default(0)
  expires_at  DateTime
  resend_at   DateTime?
  consumed_at DateTime?
  created_at  DateTime  @default(now())

  elector Elector @relation(fields: [elector_id], references: [id], onDelete: Cascade)

  @@index([elector_id])
  @@map("elector_mfa_challenges")
}

model ElectoralRoll {
  id                        String    @id @default(uuid())
  election_id               String
  elector_id                String
  has_voted                 Boolean   @default(false)
  vote_attempts             Int       @default(0)
  last_vote_attempt         DateTime?
  last_vote_candidacy_id    String?
  last_vote_idempotency_key String?
  last_vote_registered_at   DateTime?
  created_at                DateTime  @default(now())

  election     Election      @relation(fields: [election_id], references: [id])
  elector      Elector       @relation(fields: [elector_id], references: [id])
  certificates Certificate[]

  @@unique([election_id, elector_id])
  @@map("electoral_rolls")
}

model Certificate {
  id                String   @id @default(uuid())
  electoral_roll_id String
  election_id       String
  verification_code String   @unique
  created_at        DateTime @default(now())

  electoralRoll ElectoralRoll @relation(fields: [electoral_roll_id], references: [id])
  election      Election      @relation(fields: [election_id], references: [id])

  @@map("certificates")
}

// ---------------------------------------------------------------------------
// Anonymous voting (blind signature + Schnorr proof). Additive tables only.
// Deliberately no foreign key links a credential to a vote, and no table joins
// anonymous_credentials with anonymous_votes. See specs/anonymous-voting-spec.md.
// ---------------------------------------------------------------------------

// One RSA key pair per election. The private key is AES-256-GCM encrypted (base64 iv||tag||ciphertext).
model AnonymousElectionKey {
  election_id     String   @id
  public_key_pem  String   @db.Text
  private_key_enc String   @db.Text
  created_at      DateTime @default(now())

  election Election @relation(fields: [election_id], references: [id])

  @@map("anonymous_election_keys")
}

// An elector obtained a blind-signed credential for an election. Holds no ballot identifier.
model AnonymousCredential {
  id          String   @id @default(uuid())
  election_id String
  elector_id  String
  issued_at   DateTime @default(now())

  election Election @relation(fields: [election_id], references: [id])
  elector  Elector  @relation(fields: [elector_id], references: [id])

  @@unique([election_id, elector_id])
  @@map("anonymous_credentials")
}

// Registered Schnorr public keys y. No foreign key to electors: a row cannot be joined to a person.
model AnonymousCommitment {
  id          String   @id @default(uuid())
  election_id String
  y           String   @db.VarChar(64)
  created_at  DateTime @default(now())

  election Election @relation(fields: [election_id], references: [id])

  @@unique([election_id, y])
  @@map("anonymous_commitments")
}

// Anonymous ballot ledger. payload holds the JSON record of the vote, with no identity data.
// candidacy_id NULL means a blank vote.
model AnonymousVote {
  id           String   @id @default(uuid())
  election_id  String
  ballot_id    String   @unique @db.VarChar(36)
  candidacy_id String?
  payload      Json     @db.Json
  created_at   DateTime @default(now())

  election Election @relation(fields: [election_id], references: [id])

  @@index([election_id, candidacy_id])
  @@map("anonymous_votes")
}

enum MakeStatus {
  NONE
  REPORTED
  MARKED
  REJECTED
}

model VoteCredential {
  election_id          String
  elector_id           String
  voter_hash           String
  blinded_message_hash String
  blind_signature      String     @db.Text
  markStatus           MakeStatus @default(NONE)

  @@id([election_id, elector_id])
  @@index([election_id, markStatus])
  @@map("vote_credentials")
}

model PasswordRecoveryCode {
  id          String    @id @default(uuid())
  user_id     String
  code_hash   String
  attempts    Int       @default(0)
  expires_at  DateTime
  consumed_at DateTime?
  created_at  DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("password_recovery_codes")
}

model ElectorPasswordRecoveryCode {
  id          String    @id @default(uuid())
  elector_id  String
  code_hash   String
  attempts    Int       @default(0)
  expires_at  DateTime
  consumed_at DateTime?
  created_at  DateTime  @default(now())

  elector Elector @relation(fields: [elector_id], references: [id], onDelete: Cascade)

  @@index([elector_id])
  @@map("elector_password_recovery_codes")
}
